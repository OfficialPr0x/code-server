{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "noImplicitAny": false,
    "allowSyntheticDefaultImports": true,
    "lib": ["es2020", "dom"],
    "types": [
      "node",
      "express",
      "@types/js-yaml",
      "@types/semver",
      "@types/compression",
      "@types/cookie-parser",
      "@types/http-proxy",
      "@types/node-fetch",
      "@types/ws",
      "jest"
    ],
    "paths": {
      "@coder/logger": ["./node_modules/@coder/logger"],
      "../common/types": ["./src/common/types"]
    }
  },
  "include": ["src/**/*", "typings/**/*"],
  "exclude": ["node_modules"]
}
