          "content": {
            "size": 37136,
            "mimeType": "text/html",
            "compression": 0,
            "text": "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>AI War Room | Code Server</title>\n\n    <!-- Using inline styles instead of external CSS files -->\n    <style>\n      /* Base Theme */\n      :root {\n        /* Base colors */\n        --ai-bg-primary: #0a0b14;\n        --ai-bg-secondary: #1e1f2e;\n        --ai-text-primary: #f8fafc;\n        --ai-text-secondary: #94a3b8;\n        --ai-text-dim: #64748b;\n        --ai-border-color: #2d3748;\n\n        /* Accent colors */\n        --ai-gold-primary: #d4af37;\n        --ai-gold-secondary: #b4941f;\n        --ai-accent-blue: #3b82f6;\n        --ai-accent-purple: #8b5cf6;\n        --ai-accent-green: #22c55e;\n        --ai-accent-red: #ef4444;\n\n        /* UI elements */\n        --ai-card-bg: rgba(30, 31, 46, 0.8);\n        --ai-input-bg: rgba(15, 16, 30, 0.6);\n        --ai-hover-bg: rgba(255, 255, 255, 0.05);\n        --ai-active-bg: rgba(255, 255, 255, 0.1);\n\n        /* Shadows */\n        --ai-shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.2);\n        --ai-shadow-md: 0 4px 6px rgba(0, 0, 0, 0.3);\n        --ai-shadow-lg: 0 10px 15px rgba(0, 0, 0, 0.4);\n      }\n\n      body {\n        background-color: var(--ai-bg-primary);\n        color: var(--ai-text-primary);\n        font-family:\n          \"Inter\",\n          -apple-system,\n          BlinkMacSystemFont,\n          \"Segoe UI\",\n          Roboto,\n          Oxygen,\n          Ubuntu,\n          Cantarell,\n          \"Open Sans\",\n          \"Helvetica Neue\",\n          sans-serif;\n        -webkit-font-smoothing: antialiased;\n        -moz-osx-font-smoothing: grayscale;\n        margin: 0;\n        padding: 0;\n        height: 100vh;\n        overflow: hidden;\n      }\n\n      /* Reset */\n      * {\n        margin: 0;\n        padding: 0;\n        box-sizing: border-box;\n      }\n\n      /* Glass panel effect */\n      .glass-panel {\n        background: var(--ai-card-bg);\n        backdrop-filter: blur(12px);\n        -webkit-backdrop-filter: blur(12px);\n        border: 1px solid var(--ai-border-color);\n        border-radius: 12px;\n        box-shadow: var(--ai-shadow-lg);\n      }\n\n      /* IDE Container */\n      .ai-ide-container {\n        display: grid;\n        grid-template-areas:\n          \"logo header header header\"\n          \"sidebar explorer editor lab\"\n          \"sidebar explorer editor lab\"\n          \"sidebar agents editor lab\"\n          \"status status status status\";\n        grid-template-columns: 48px 240px 1fr 400px;\n        grid-template-rows: 48px 1fr 1fr auto auto;\n        height: 100vh;\n        background: var(--ai-bg-primary);\n      }\n\n      /* Logo Area */\n      .ai-ide-logo {\n        grid-area: logo;\n        display: flex;\n        align-items: center;\n        justify-content: center;\n        background: var(--ai-bg-secondary);\n        border-bottom: 1px solid var(--ai-border-color);\n      }\n\n      .ai-ide-logo svg {\n        width: 24px;\n        height: 24px;\n        fill: var(--ai-gold-primary);\n      }\n\n      /* Header Bar */\n      .ai-ide-header {\n        grid-area: header;\n        display: flex;\n        align-items: center;\n        justify-content: space-between;\n        padding: 0 16px;\n        background: var(--ai-bg-secondary);\n        border-bottom: 1px solid var(--ai-border-color);\n      }\n\n      .ai-ide-search {\n        flex: 1;\n        max-width: 600px;\n        margin-right: 16px;\n      }\n\n      .ai-ide-search input {\n        width: 100%;\n        height: 32px;\n        padding: 0 32px;\n        background: var(--ai-input-bg);\n        border: 1px solid var(--ai-border-color);\n        border-radius: 4px;\n        color: var(--ai-text-primary);\n        font-size: 14px;\n      }\n\n      .ai-ide-search-icon {\n        position: absolute;\n        left: 8px;\n        top: 50%;\n        transform: translateY(-50%);\n        color: var(--ai-text-dim);\n      }\n\n      .ai-ide-user-menu {\n        display: flex;\n        align-items: center;\n        gap: 12px;\n      }\n\n      .ai-ide-user-avatar {\n        width: 32px;\n        height: 32px;\n        border-radius: 50%;\n        background: var(--ai-accent-purple);\n        color: white;\n        display: flex;\n        align-items: center;\n        justify-content: center;\n        font-weight: 500;\n        font-size: 14px;\n      }\n\n      /* Sidebar */\n      .ai-ide-sidebar {\n        grid-area: sidebar;\n        display: flex;\n        flex-direction: column;\n        background: var(--ai-bg-secondary);\n        border-right: 1px solid var(--ai-border-color);\n        padding: 8px 0;\n      }\n\n      .ai-ide-sidebar-btn {\n        width: 48px;\n        height: 48px;\n        display: flex;\n        align-items: center;\n        justify-content: center;\n        color: var(--ai-text-secondary);\n        cursor: pointer;\n        transition: all 0.2s ease;\n      }\n\n      .ai-ide-sidebar-btn:hover {\n        color: var(--ai-text-primary);\n      }\n\n      .ai-ide-sidebar-btn.active {\n        color: var(--ai-gold-primary);\n        border-left: 2px solid var(--ai-gold-primary);\n        background: var(--ai-active-bg);\n      }\n\n      /* Explorer Panel */\n      .ai-ide-explorer {\n        grid-area: explorer;\n        display: flex;\n        flex-direction: column;\n        background: var(--ai-bg-secondary);\n        border-right: 1px solid var(--ai-border-color);\n      }\n\n      .ai-ide-explorer-header {\n        display: flex;\n        align-items: center;\n        justify-content: space-between;\n        padding: 8px 16px;\n        font-weight: 600;\n        font-size: 11px;\n        text-transform: uppercase;\n        letter-spacing: 0.5px;\n        color: var(--ai-text-secondary);\n      }\n\n      .ai-ide-explorer-actions {\n        display: flex;\n        gap: 8px;\n      }\n\n      .ai-ide-explorer-action {\n        color: var(--ai-text-dim);\n        cursor: pointer;\n        transition: color 0.2s ease;\n      }\n\n      .ai-ide-explorer-action:hover {\n        color: var(--ai-text-primary);\n      }\n\n      .ai-ide-explorer-content {\n        flex: 1;\n        overflow-y: auto;\n        padding: 8px;\n      }\n\n      /* Editor Area */\n      .ai-ide-editor {\n        grid-area: editor;\n        display: flex;\n        flex-direction: column;\n        background: var(--ai-bg-primary);\n      }\n\n      .ai-ide-editor-tabs {\n        display: flex;\n        background: var(--ai-bg-secondary);\n        border-bottom: 1px solid var(--ai-border-color);\n        height: 35px;\n        overflow-x: auto;\n      }\n\n      .ai-ide-editor-tab {\n        display: flex;\n        align-items: center;\n        gap: 6px;\n        padding: 0 12px;\n        height: 100%;\n        font-size: 13px;\n        color: var(--ai-text-secondary);\n        border-right: 1px solid var(--ai-border-color);\n        cursor: pointer;\n        user-select: none;\n        min-width: 120px;\n      }\n\n      .ai-ide-editor-tab.active {\n        background: var(--ai-bg-primary);\n        color: var(--ai-text-primary);\n      }\n\n      .ai-ide-editor-content {\n        flex: 1;\n        overflow: hidden;\n      }\n\n      /* AI Agents Panel */\n      .ai-ide-agents {\n        grid-area: agents;\n        display: flex;\n        flex-direction: column;\n        background: var(--ai-bg-secondary);\n        border-right: 1px solid var(--ai-border-color);\n        border-top: 1px solid var(--ai-border-color);\n      }\n\n      .ai-ide-agents-header {\n        display: flex;\n        align-items: center;\n        justify-content: space-between;\n        padding: 8px 16px;\n        font-weight: 600;\n        font-size: 11px;\n        text-transform: uppercase;\n        letter-spacing: 0.5px;\n        color: var(--ai-text-secondary);\n      }\n\n      .ai-ide-agents-content {\n        flex: 1;\n        overflow-y: auto;\n        padding: 16px;\n        display: flex;\n        flex-direction: column;\n        gap: 12px;\n      }\n\n      /* Agent Card */\n      .ai-agent-card {\n        background: var(--ai-card-bg);\n        border: 1px solid var(--ai-border-color);\n        border-radius: 8px;\n        padding: 12px;\n        transition: all 0.2s ease;\n      }\n\n      .ai-agent-card:hover {\n        transform: translateY(-2px);\n        box-shadow: var(--ai-shadow-md);\n      }\n\n      .ai-agent-header {\n        display: flex;\n        align-items: center;\n        gap: 12px;\n        margin-bottom: 12px;\n      }\n\n      .ai-agent-avatar {\n        width: 40px;\n        height: 40px;\n        border-radius: 8px;\n        background: var(--ai-accent-blue);\n        display: flex;\n        align-items: center;\n        justify-content: center;\n        color: white;\n        font-size: 20px;\n      }\n\n      .ai-agent-info {\n        flex: 1;\n      }\n\n      .ai-agent-name {\n        font-weight: 600;\n        margin-bottom: 2px;\n      }\n\n      .ai-agent-role {\n        font-size: 12px;\n        color: var(--ai-gold-primary);\n      }\n\n      .ai-agent-level {\n        display: flex;\n        align-items: center;\n        gap: 8px;\n        margin-bottom: 12px;\n      }\n\n      .ai-agent-level-text {\n        font-size: 12px;\n        color: var(--ai-text-secondary);\n        min-width: 60px;\n      }\n\n      .ai-agent-level-bar {\n        flex: 1;\n        height: 4px;\n        background: var(--ai-input-bg);\n        border-radius: 2px;\n        overflow: hidden;\n      }\n\n      .ai-agent-level-progress {\n        height: 100%;\n        background: var(--ai-gold-primary);\n        border-radius: 2px;\n        transition: width 0.3s ease;\n      }\n\n      .ai-agent-actions {\n        display: flex;\n        gap: 8px;\n      }\n\n      .ai-agent-action {\n        flex: 1;\n        text-align: center;\n        padding: 6px 0;\n        background: var(--ai-input-bg);\n        border: 1px solid var(--ai-border-color);\n        border-radius: 4px;\n        font-size: 13px;\n        cursor: pointer;\n        transition: all 0.2s ease;\n      }\n\n      .ai-agent-action:hover {\n        background: var(--ai-hover-bg);\n        border-color: var(--ai-gold-primary);\n        color: var(--ai-gold-primary);\n      }\n\n      /* Status Bar */\n      .ai-ide-status {\n        grid-area: status;\n        display: flex;\n        align-items: center;\n        padding: 0 8px;\n        height: 24px;\n        background: var(--ai-bg-secondary);\n        border-top: 1px solid var(--ai-border-color);\n        font-size: 12px;\n        color: var(--ai-text-secondary);\n      }\n\n      .ai-ide-status-item {\n        display: flex;\n        align-items: center;\n        gap: 4px;\n        padding: 0 8px;\n        cursor: pointer;\n      }\n\n      .ai-ide-status-item:hover {\n        color: var(--ai-text-primary);\n      }\n\n      .ai-ide-status-item.active {\n        color: var(--ai-accent-green);\n      }\n\n      .ai-ide-status-separator {\n        width: 1px;\n        height: 16px;\n        background: var(--ai-border-color);\n        margin: 0 4px;\n      }\n\n      .ai-ide-status-right {\n        margin-left: auto;\n        display: flex;\n        align-items: center;\n      }\n\n      /* Chat Messages */\n      .ai-chat-message {\n        margin-bottom: 16px;\n      }\n\n      .ai-chat-message-avatar {\n        width: 28px;\n        height: 28px;\n        border-radius: 50%;\n        display: flex;\n        align-items: center;\n        justify-content: center;\n        float: left;\n        margin-right: 10px;\n      }\n\n      .ai-chat-message-content {\n        background: rgba(30, 58, 138, 0.2);\n        border-radius: 0 8px 8px 8px;\n        padding: 10px;\n        margin-left: 38px;\n      }\n\n      .ai-chat-message-content p {\n        margin: 0;\n        line-height: 1.5;\n      }\n\n      .ai-chat-message-content code {\n        background: var(--ai-input-bg);\n        padding: 2px 4px;\n        border-radius: 4px;\n        font-family: \"JetBrains Mono\", monospace;\n        font-size: 0.9em;\n      }\n\n      /* Animations */\n      @keyframes pulse {\n        0% {\n          box-shadow: 0 0 0 0 rgba(212, 175, 55, 0.4);\n        }\n        70% {\n          box-shadow: 0 0 0 10px rgba(212, 175, 55, 0);\n        }\n        100% {\n          box-shadow: 0 0 0 0 rgba(212, 175, 55, 0);\n        }\n      }\n\n      .pulse-animation {\n        animation: pulse 2s infinite;\n      }\n\n      /* Badges */\n      .badge {\n        display: inline-flex;\n        align-items: center;\n        gap: 4px;\n        padding: 4px 8px;\n        border-radius: 4px;\n        font-size: 12px;\n        font-weight: 500;\n      }\n\n      .badge.success {\n        background: rgba(34, 197, 94, 0.2);\n        color: var(--ai-accent-green);\n      }\n\n      .badge.warning {\n        background: rgba(212, 175, 55, 0.2);\n        color: var(--ai-gold-primary);\n      }\n\n      .badge.error {\n        background: rgba(239, 68, 68, 0.2);\n        color: var(--ai-accent-red);\n      }\n\n      /* Scrollbars */\n      ::-webkit-scrollbar {\n        width: 8px;\n        height: 8px;\n      }\n\n      ::-webkit-scrollbar-track {\n        background: var(--ai-bg-primary);\n      }\n\n      ::-webkit-scrollbar-thumb {\n        background: var(--ai-border-color);\n        border-radius: 4px;\n      }\n\n      ::-webkit-scrollbar-thumb:hover {\n        background: var(--ai-text-dim);\n      }\n\n      /* AI Lab Panel */\n      .ai-lab-panel {\n        background: var(--ai-panel-bg);\n        border: 1px solid var(--ai-border-color);\n        border-radius: 8px;\n        backdrop-filter: blur(12px);\n        display: flex;\n        flex-direction: column;\n        overflow: hidden;\n      }\n\n      .ai-lab-header {\n        padding: 12px 16px;\n        border-bottom: 1px solid var(--ai-border-color);\n        display: flex;\n        align-items: center;\n        justify-content: space-between;\n      }\n\n      .ai-lab-tabs {\n        display: flex;\n        gap: 8px;\n      }\n\n      .ai-lab-tabs button {\n        background: var(--ai-input-bg);\n        border: 1px solid transparent;\n        padding: 6px 12px;\n        border-radius: 4px;\n        color: var(--ai-text-secondary);\n        cursor: pointer;\n        transition: all var(--ai-transition-fast);\n      }\n\n      .ai-lab-tabs button.active {\n        border-color: var(--ai-gold-primary);\n        color: var(--ai-gold-primary);\n        background: var(--ai-card-bg);\n      }\n\n      .ai-lab-content {\n        flex: 1;\n        display: flex;\n        overflow: hidden;\n      }\n\n      .lab-tab {\n        display: none;\n        flex: 1;\n        padding: 16px;\n      }\n\n      .lab-tab.active {\n        display: flex;\n        flex-direction: column;\n      }\n\n      .agent-config-editor {\n        flex: 1;\n        background: var(--ai-bg-dark);\n        border: 1px solid var(--ai-border-color);\n        border-radius: 6px;\n        overflow: hidden;\n      }\n\n      .testing-console {\n        background: var(--ai-bg-dark);\n        border: 1px solid var(--ai-border-color);\n        border-radius: 6px;\n        padding: 12px;\n        font-family: \"JetBrains Mono\", monospace;\n        font-size: 13px;\n        color: var(--ai-text-primary);\n        white-space: pre-wrap;\n        overflow-y: auto;\n      }\n\n      .lab-actions {\n        display: flex;\n        gap: 8px;\n        padding: 16px 0;\n        border-top: 1px solid var(--ai-border-color);\n        margin-top: 16px;\n      }\n\n      /* Marketplace Grid */\n      .ai-marketplace-content {\n        display: grid;\n        grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));\n        gap: 16px;\n        padding: 16px;\n      }\n\n      .marketplace-agent-card {\n        background: var(--ai-card-bg);\n        border: 1px solid var(--ai-border-color);\n        border-radius: 8px;\n        padding: 16px;\n        transition: all var(--ai-transition-fast);\n      }\n\n      .marketplace-agent-card:hover {\n        transform: translateY(-2px);\n        border-color: var(--ai-gold-primary);\n      }\n\n      .agent-preview {\n        position: relative;\n        height: 160px;\n        background: var(--ai-bg-dark);\n        border-radius: 6px;\n        margin-bottom: 12px;\n        overflow: hidden;\n      }\n\n      .agent-meta {\n        display: flex;\n        justify-content: space-between;\n        font-size: 12px;\n        color: var(--ai-text-dim);\n        margin-bottom: 8px;\n      }\n\n      .agent-price {\n        color: var(--ai-gold-primary);\n        font-weight: 600;\n      }\n\n      /* Testing Arena */\n      .testing-toolbar {\n        display: flex;\n        gap: 8px;\n        padding-bottom: 12px;\n        border-bottom: 1px solid var(--ai-border-color);\n        margin-bottom: 12px;\n      }\n\n      .test-case {\n        background: var(--ai-card-bg);\n        border: 1px solid var(--ai-border-color);\n        border-radius: 6px;\n        padding: 12px;\n        margin-bottom: 8px;\n      }\n\n      .test-status {\n        width: 10px;\n        height: 10px;\n        border-radius: 50%;\n        margin-right: 8px;\n      }\n\n      .test-status.passed {\n        background: var(--ai-accent-green);\n      }\n      .test-status.failed {\n        background: var(--ai-accent-red);\n      }\n      .test-status.pending {\n        background: var(--ai-gold-primary);\n      }\n\n      /* Responsive Adjustments */\n      @media (max-width: 1200px) {\n        .ai-marketplace-content {\n          grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));\n        }\n\n        .lab-actions {\n          flex-direction: column;\n        }\n      }\n    </style>\n\n    <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap\" rel=\"stylesheet\" />\n    <link href=\"https://cdn.jsdelivr.net/npm/boxicons@2.1.4/css/boxicons.min.css\" rel=\"stylesheet\" />\n  </head>\n  <body class=\"ai-theme\">\n    <div class=\"ai-ide-container\">\n      <!-- Logo Area -->\n      <div class=\"ai-ide-logo\">\n        <svg viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n          <path\n            d=\"M12 2L2 7v10l10 5 10-5V7L12 2zm0 2.33l7 3.5v1.04L12 12.33 5 8.87V7.83l7-3.5zm0 10.34l-7-3.5v-3.5l7 3.5 7-3.5v3.5l-7 3.5z\"\n          />\n        </svg>\n      </div>\n\n      <!-- Header Bar -->\n      <div class=\"ai-ide-header\">\n        <div class=\"ai-ide-search\" style=\"position: relative\">\n          <i class=\"bx bx-search ai-ide-search-icon\"></i>\n          <input type=\"text\" placeholder=\"Search everything (Ctrl+Shift+P)\" />\n        </div>\n        <div class=\"ai-ide-user-menu\">\n          <div class=\"badge success\">\n            <i class=\"bx bx-wallet\"></i>\n            Connected\n          </div>\n          <div class=\"ai-ide-user-avatar\">JS</div>\n        </div>\n      </div>\n\n      <!-- Side Bar -->\n      <div class=\"ai-ide-sidebar\">\n        <div class=\"ai-ide-sidebar-btn active\" title=\"Explorer\">\n          <i class=\"bx bx-folder bx-sm\"></i>\n        </div>\n        <div class=\"ai-ide-sidebar-btn\" title=\"Search\">\n          <i class=\"bx bx-search-alt bx-sm\"></i>\n        </div>\n        <div class=\"ai-ide-sidebar-btn\" title=\"Source Control\">\n          <i class=\"bx bx-git-branch bx-sm\"></i>\n        </div>\n        <div class=\"ai-ide-sidebar-btn\" title=\"Extensions\">\n          <i class=\"bx bx-extension bx-sm\"></i>\n        </div>\n        <div class=\"ai-ide-sidebar-btn pulse-animation\" title=\"AI Agents\">\n          <i class=\"bx bx-bot bx-sm\"></i>\n        </div>\n        <div class=\"ai-ide-sidebar-btn\" title=\"Agent Marketplace\" style=\"margin-top: auto\">\n          <i class=\"bx bx-store bx-sm\"></i>\n        </div>\n        <div class=\"ai-ide-sidebar-btn\" title=\"AI Lab\">\n          <i class=\"bx bx-test-tube bx-sm\"></i>\n        </div>\n        <div class=\"ai-ide-sidebar-btn\" title=\"Settings\">\n          <i class=\"bx bx-cog bx-sm\"></i>\n        </div>\n      </div>\n\n      <!-- Explorer Panel -->\n      <div class=\"ai-ide-explorer\">\n        <div class=\"ai-ide-explorer-header\">\n          <span>Explorer</span>\n          <div class=\"ai-ide-explorer-actions\">\n            <i class=\"bx bx-plus ai-ide-explorer-action\" title=\"New File\"></i>\n            <i class=\"bx bx-folder-plus ai-ide-explorer-action\" title=\"New Folder\"></i>\n            <i class=\"bx bx-refresh ai-ide-explorer-action\" title=\"Refresh\"></i>\n            <i class=\"bx bx-collapse ai-ide-explorer-action\" title=\"Collapse\"></i>\n          </div>\n        </div>\n        <div class=\"ai-ide-explorer-content\">\n          <!-- File Tree Structure -->\n          <div class=\"file-tree\">\n            <!-- Project folder -->\n            <div class=\"file-tree-item folder open\" style=\"padding-left: 8px; margin-bottom: 4px\">\n              <div\n                class=\"file-tree-item-content\"\n                style=\"display: flex; align-items: center; padding: 4px 8px; cursor: pointer\"\n              >\n                <i class=\"bx bx-folder-open\" style=\"color: var(--ai-gold-primary); margin-right: 6px\"></i>\n                <span style=\"font-weight: 600\">ai-warroom-project</span>\n              </div>\n\n              <!-- Nested files -->\n              <div class=\"file-tree-children\" style=\"padding-left: 16px\">\n                <!-- Folders -->\n                <div class=\"file-tree-item folder\" style=\"margin: 2px 0\">\n                  <div\n                    class=\"file-tree-item-content\"\n                    style=\"display: flex; align-items: center; padding: 4px 8px; cursor: pointer\"\n                  >\n                    <i class=\"bx bx-folder\" style=\"color: var(--ai-gold-primary); margin-right: 6px\"></i>\n                    <span>src</span>\n                  </div>\n                </div>\n\n                <div class=\"file-tree-item folder\" style=\"margin: 2px 0\">\n                  <div\n                    class=\"file-tree-item-content\"\n                    style=\"display: flex; align-items: center; padding: 4px 8px; cursor: pointer\"\n                  >\n                    <i class=\"bx bx-folder\" style=\"color: var(--ai-gold-primary); margin-right: 6px\"></i>\n                    <span>models</span>\n                  </div>\n                </div>\n\n                <!-- Files -->\n                <div class=\"file-tree-item\" style=\"margin: 2px 0\">\n                  <div\n                    class=\"file-tree-item-content\"\n                    style=\"display: flex; align-items: center; padding: 4px 8px; cursor: pointer\"\n                  >\n                    <i class=\"bx bxs-file-json\" style=\"color: #e8d44d; margin-right: 6px\"></i>\n                    <span>package.json</span>\n                  </div>\n                </div>\n\n                <div class=\"file-tree-item\" style=\"margin: 2px 0\">\n                  <div\n                    class=\"file-tree-item-content\"\n                    style=\"display: flex; align-items: center; padding: 4px 8px; cursor: pointer\"\n                  >\n                    <i class=\"bx bxs-file-md\" style=\"color: #9ca3af; margin-right: 6px\"></i>\n                    <span>README.md</span>\n                  </div>\n                </div>\n\n                <div class=\"file-tree-item\" style=\"margin: 2px 0\">\n                  <div\n                    class=\"file-tree-item-content\"\n                    style=\"display: flex; align-items: center; padding: 4px 8px; cursor: pointer\"\n                  >\n                    <i class=\"bx bxs-file-js\" style=\"color: #e8d44d; margin-right: 6px\"></i>\n                    <span>index.js</span>\n                  </div>\n                </div>\n\n                <div class=\"file-tree-item\" style=\"margin: 2px 0\">\n                  <div\n                    class=\"file-tree-item-content\"\n                    style=\"display: flex; align-items: center; padding: 4px 8px; cursor: pointer\"\n                  >\n                    <i class=\"bx bxs-file\" style=\"color: #9ca3af; margin-right: 6px\"></i>\n                    <span>.env</span>\n                  </div>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <!-- Editor Area -->\n      <div class=\"ai-ide-editor\">\n        <div class=\"ai-ide-editor-tabs\">\n          <div class=\"ai-ide-editor-tab active\">\n            <i class=\"bx bxs-file-js\" style=\"color: #e8d44d\"></i>\n            <span>index.js</span>\n            <i class=\"bx bx-x\" style=\"margin-left: auto\"></i>\n          </div>\n          <div class=\"ai-ide-editor-tab\">\n            <i class=\"bx bxs-file-json\" style=\"color: #e8d44d\"></i>\n            <span>package.json</span>\n            <i class=\"bx bx-x\" style=\"margin-left: auto\"></i>\n          </div>\n        </div>\n        <div class=\"ai-ide-editor-content\">\n          <!-- Monaco editor will be initialized by the script at the end of the document -->\n          <div id=\"monaco-editor\" style=\"width: 100%; height: 100%\"></div>\n        </div>\n      </div>\n\n      <!-- AI Agents Panel -->\n      <div class=\"ai-ide-agents\">\n        <div class=\"ai-ide-agents-header\">\n          <span>AI Agents</span>\n          <div class=\"ai-ide-explorer-actions\">\n            <i class=\"bx bx-plus ai-ide-explorer-action\" title=\"Add Agent\"></i>\n            <i class=\"bx bx-cog ai-ide-explorer-action\" title=\"Agent Settings\"></i>\n          </div>\n        </div>\n        <div class=\"ai-ide-agents-content\">\n          <!-- Agent cards sample (will be replaced by agent-interactions.js) -->\n          <div class=\"ai-agent-card\" data-id=\"agent-1\">\n            <div class=\"ai-agent-header\">\n              <div class=\"ai-agent-avatar\" style=\"background: var(--ai-accent-blue)\">\n                <i class=\"bx bx-code-alt\"></i>\n              </div>\n              <div class=\"ai-agent-info\">\n                <div class=\"ai-agent-name\">Code Assistant</div>\n                <div class=\"ai-agent-role\">Code Assistant</div>\n              </div>\n            </div>\n            <div class=\"ai-agent-level\">\n              <div class=\"ai-agent-level-text\">Level 3</div>\n              <div class=\"ai-agent-level-bar\">\n                <div class=\"ai-agent-level-progress\" style=\"width: 70%\"></div>\n              </div>\n            </div>\n            <div class=\"ai-agent-actions\">\n              <div class=\"ai-agent-action\" data-action=\"chat\">Chat</div>\n              <div class=\"ai-agent-action\" data-action=\"assign\">Assign Task</div>\n            </div>\n          </div>\n          <div class=\"ai-agent-card\" data-id=\"agent-2\">\n            <div class=\"ai-agent-header\">\n              <div class=\"ai-agent-avatar\" style=\"background: var(--ai-accent-red)\">\n                <i class=\"bx bx-bug\"></i>\n              </div>\n              <div class=\"ai-agent-info\">\n                <div class=\"ai-agent-name\">Debug Wizard</div>\n                <div class=\"ai-agent-role\">Debugger</div>\n              </div>\n            </div>\n            <div class=\"ai-agent-level\">\n              <div class=\"ai-agent-level-text\">Level 2</div>\n              <div class=\"ai-agent-level-bar\">\n                <div class=\"ai-agent-level-progress\" style=\"width: 45%\"></div>\n              </div>\n            </div>\n            <div class=\"ai-agent-actions\">\n              <div class=\"ai-agent-action\" data-action=\"chat\">Chat</div>\n              <div class=\"ai-agent-action\" data-action=\"assign\">Assign Task</div>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <!-- Status Bar -->\n      <div class=\"ai-ide-status\">\n        <div class=\"ai-ide-status-item\">\n          <i class=\"bx bx-git-branch\"></i>\n          <span>main</span>\n        </div>\n        <div class=\"ai-ide-status-separator\"></div>\n        <div class=\"ai-ide-status-item active\">\n          <i class=\"bx bx-check-circle\"></i>\n          <span>0 Problems</span>\n        </div>\n        <div class=\"ai-ide-status-separator\"></div>\n        <div class=\"ai-ide-status-item\">\n          <i class=\"bx bx-bot\"></i>\n          <span>3 Agents Online</span>\n        </div>\n\n        <div class=\"ai-ide-status-right\">\n          <div class=\"ai-ide-status-item\">\n            <i class=\"bx bx-wallet\"></i>\n            <span>0.05 ETH</span>\n          </div>\n          <div class=\"ai-ide-status-separator\"></div>\n          <div class=\"ai-ide-status-item\">\n            <i class=\"bx bx-current-location\"></i>\n            <span>Ln 42, Col 17</span>\n          </div>\n          <div class=\"ai-ide-status-separator\"></div>\n          <div class=\"ai-ide-status-item\">\n            <i class=\"bx bx-code\"></i>\n            <span>JavaScript</span>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <!-- AI Chat Dialog -->\n    <div\n      class=\"ai-chat-dialog glass-panel\"\n      style=\"\n        position: fixed;\n        bottom: 20px;\n        right: 20px;\n        width: 380px;\n        height: 480px;\n        display: none;\n        flex-direction: column;\n        overflow: hidden;\n        z-index: 1000;\n      \"\n    >\n      <div\n        class=\"ai-chat-header\"\n        style=\"\n          display: flex;\n          align-items: center;\n          justify-content: space-between;\n          padding: 12px 16px;\n          border-bottom: 1px solid var(--ai-border-color);\n        \"\n      >\n        <div style=\"display: flex; align-items: center; gap: 10px\">\n          <div class=\"ai-agent-avatar\" style=\"width: 28px; height: 28px\">\n            <i class=\"bx bx-code-alt\"></i>\n          </div>\n          <span style=\"font-weight: 600\">Code Assistant</span>\n        </div>\n        <div style=\"display: flex; gap: 8px\">\n          <i class=\"bx bx-minus\" style=\"cursor: pointer\"></i>\n          <i class=\"bx bx-x\" style=\"cursor: pointer\"></i>\n        </div>\n      </div>\n      <div class=\"ai-chat-messages\" style=\"flex: 1; overflow-y: auto; padding: 16px\">\n        <!-- Messages will be populated by agent-interactions.js -->\n      </div>\n      <div class=\"ai-chat-input\" style=\"padding: 12px 16px; border-top: 1px solid var(--ai-border-color)\">\n        <div style=\"position: relative\">\n          <textarea\n            placeholder=\"Ask me anything...\"\n            style=\"\n              width: 100%;\n              height: 40px;\n              resize: none;\n              padding: 8px 36px 8px 12px;\n              background: var(--ai-input-bg);\n              border: 1px solid var(--ai-border-color);\n              border-radius: 6px;\n            \"\n          ></textarea>\n          <button\n            style=\"\n              position: absolute;\n              right: 8px;\n              top: 50%;\n              transform: translateY(-50%);\n              background: transparent;\n              border: none;\n              color: var(--ai-gold-primary);\n              cursor: pointer;\n            \"\n          >\n            <i class=\"bx bx-send\"></i>\n          </button>\n        </div>\n      </div>\n    </div>\n\n    <!-- Agent Marketplace Modal -->\n    <div\n      class=\"ai-marketplace-modal glass-panel\"\n      style=\"\n        position: fixed;\n        top: 50%;\n        left: 50%;\n        transform: translate(-50%, -50%);\n        width: 800px;\n        height: 600px;\n        display: none;\n        flex-direction: column;\n        z-index: 1001;\n        border-radius: 12px;\n        overflow: hidden;\n      \"\n    >\n      <div\n        class=\"ai-marketplace-header\"\n        style=\"\n          display: flex;\n          align-items: center;\n          justify-content: space-between;\n          padding: 16px;\n          border-bottom: 1px solid var(--ai-border-color);\n        \"\n      >\n        <h2 style=\"margin: 0\">AI Agent Marketplace</h2>\n        <i class=\"bx bx-x\" style=\"font-size: 24px; cursor: pointer\"></i>\n      </div>\n      <div class=\"ai-marketplace-content\" style=\"flex: 1; overflow-y: auto; padding: 20px\">\n        <!-- Marketplace content will be populated by agent-interactions.js -->\n      </div>\n    </div>\n\n    <!-- AI Lab Panel -->\n    <div class=\"ai-lab-panel\">\n      <div class=\"ai-lab-header\">\n        <h3>AI Agent Playground</h3>\n        <div class=\"ai-lab-tabs\">\n          <button class=\"active\" data-tab=\"builder\">Agent Builder</button>\n          <button data-tab=\"testing\">Testing Arena</button>\n        </div>\n      </div>\n\n      <div class=\"ai-lab-content\">\n        <div id=\"agent-builder\" class=\"lab-tab active\">\n          <div class=\"agent-config-editor\" id=\"agent-config-editor\"></div>\n          <div class=\"lab-actions\">\n            <button class=\"btn-save\" onclick=\"saveAgentConfig()\"><i class=\"bx bx-save\"></i> Save Agent</button>\n            <button class=\"btn-test\" onclick=\"deployTestAgent()\"><i class=\"bx bx-rocket\"></i> Deploy Test</button>\n          </div>\n        </div>\n\n        <div id=\"testing-arena\" class=\"lab-tab\">\n          <div class=\"testing-console\" id=\"testing-console\"></div>\n        </div>\n      </div>\n    </div>\n\n    <!-- Scripts -->\n    <script src=\"https://cdn.jsdelivr.net/npm/monaco-editor@0.39.0/min/vs/loader.js\"></script>\n    <script src=\"/ai-warroom/agent-interactions.js\"></script>\n    <script src=\"/ai-warroom/agents.js\"></script>\n    <script src=\"/ai-warroom/filesystem.js\"></script>\n    <script src=\"/ai-warroom/extensions.js\"></script>\n    <script>\n      // Initialize Monaco Editor\n      require.config({ paths: { vs: \"/ai-warroom/vs\" } });\n      require([\"vs/editor/editor.main\"], function () {\n        // Load sample code for demonstration\n        const sampleCode = `// Welcome to AI War Room IDE\n// Start coding with AI assistance\n\nfunction calculateFibonacci(n) {\n  if (n <= 1) return n;\n  \n  let a = 0, b = 1;\n  for (let i = 2; i <= n; i++) {\n    const temp = a + b;\n    a = b;\n    b = temp;\n  }\n  \n  return b;\n}\n\n// Example usage\nconsole.log(\"Fibonacci(10) =\", calculateFibonacci(10));\n`;\n        \n        // Create editor instance\n        if (typeof monaco !== 'undefined') {\n          window.editor = monaco.editor.create(document.getElementById(\"monaco-editor\"), {\n            value: sampleCode,\n            language: \"javascript\",\n            theme: \"vs-dark\",\n            automaticLayout: true,\n            minimap: {\n              enabled: true\n            }\n          });\n        } else {\n          console.error(\"Monaco editor not loaded correctly\");\n        }\n      });\n\n      // Initialize basic UI interactions until agent-interactions.js fully loads\n      document.addEventListener(\"DOMContentLoaded\", function () {\n        // Show chat dialog when clicking on agent cards or chat actions\n        const agentCards = document.querySelectorAll(\".ai-agent-card\")\n        const chatDialog = document.querySelector(\".ai-chat-dialog\")\n\n        agentCards.forEach((card) => {\n          card.addEventListener(\"click\", function (e) {\n            // Check if clicked on the chat action or the card itself\n            if (e.target.closest('.ai-agent-action[data-action=\"chat\"]') || !e.target.closest(\".ai-agent-action\")) {\n              const agentName = card.querySelector(\".ai-agent-name\").textContent\n              const agentAvatar = card.querySelector(\".ai-agent-avatar\").innerHTML\n\n              // Update chat dialog header\n              document.querySelector(\".ai-chat-header span\").textContent = agentName\n              document.querySelector(\".ai-chat-header .ai-agent-avatar\").innerHTML = agentAvatar\n\n              // Show chat dialog\n              chatDialog.style.display = \"flex\"\n\n              // Focus on input\n              setTimeout(() => {\n                document.querySelector(\".ai-chat-input textarea\").focus()\n              }, 100)\n            }\n          })\n        })\n\n        // Close chat dialog when clicking on the close button\n        document.querySelector(\".ai-chat-header .bx-x\").addEventListener(\"click\", function () {\n          chatDialog.style.display = \"none\"\n        })\n\n        // Handle minimize chat\n        document.querySelector(\".ai-chat-header .bx-minus\").addEventListener(\"click\", function () {\n          if (chatDialog.style.height === \"48px\") {\n            chatDialog.style.height = \"480px\"\n            chatDialog.querySelector(\".ai-chat-messages\").style.display = \"block\"\n            chatDialog.querySelector(\".ai-chat-input\").style.display = \"block\"\n          } else {\n            chatDialog.style.height = \"48px\"\n            chatDialog.querySelector(\".ai-chat-messages\").style.display = \"none\"\n            chatDialog.querySelector(\".ai-chat-input\").style.display = \"none\"\n          }\n        })\n\n        // Handle agent marketplace button\n        document.querySelector('.ai-ide-sidebar-btn[title=\"Agent Marketplace\"]').addEventListener(\"click\", function () {\n          document.querySelector(\".ai-marketplace-modal\").style.display = \"flex\"\n        })\n\n        // Close marketplace modal\n        document.querySelector(\".ai-marketplace-modal .bx-x\").addEventListener(\"click\", function () {\n          document.querySelector(\".ai-marketplace-modal\").style.display = \"none\"\n        })\n      })\n\n      // File System Integration\n      const fs = new VirtualFileSystem({\n        basePath: \"/ai-warroom/workspace\",\n        useBrowserFS: true,\n      })\n\n      // Extension Management\n      const extensionManager = new ExtensionManager({\n        apiEndpoint: \"/api/extensions\",\n        wsEndpoint: `wss://${location.host}/extensions`,\n      })\n\n      // AI Lab Initialization\n      const labEditor = monaco.editor.create(document.getElementById(\"agent-config-editor\"), {\n        language: \"json\",\n        theme: \"ai-war-room-theme\",\n        value: JSON.stringify(\n          {\n            name: \"New Agent\",\n            description: \"\",\n            model: \"anthropic/claude-3-sonnet\",\n            skills: [],\n          },\n          null,\n          2,\n        ),\n      })\n\n      async function saveAgentConfig() {\n        const config = labEditor.getValue()\n        await fetch(\"/api/agents/config\", {\n          method: \"POST\",\n          body: config,\n        })\n      }\n    </script>\n  </body>\n</html>\n"
          },
